# CULTURA — example configuration
#
# Copy this file to `.env` and edit the values you need:
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:      cp .env.example .env
#
# `.env` is git-ignored, so real values are never committed.
#
# NOTE: the application does not read a `.env` file automatically, because
# that would require an extra dependency. Either export the variables in your
# terminal before starting the app, or set them in `config.py`.

# ---------------------------------------------------------------------------
# Secret key — used to sign the session cookie and the CSRF token.
# Generate a random one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------
CULTURA_SECRET_KEY=change-this-to-a-long-random-string

# ---------------------------------------------------------------------------
# Host and port used by `python app.py`
# ---------------------------------------------------------------------------
CULTURA_HOST=127.0.0.1
CULTURA_PORT=5000

# ---------------------------------------------------------------------------
# Public URL, used for Open Graph metadata
# ---------------------------------------------------------------------------
CULTURA_SITE_URL=http://127.0.0.1:5000

# ---------------------------------------------------------------------------
# Set to 1 when the site is served over HTTPS so the session cookie is only
# sent over a secure connection.
# ---------------------------------------------------------------------------
CULTURA_HTTPS=0

# ---------------------------------------------------------------------------
# Where the JSON data files live. Point these at another directory to run the
# site against a different dataset (the test-suite does exactly this).
# ---------------------------------------------------------------------------
CULTURA_DATA_DIR=./data
CULTURA_EVENTS_FILE=./data/events.json
CULTURA_REGISTRATIONS_FILE=./data/registrations.json
CULTURA_SETTINGS_FILE=./data/settings.json
CULTURA_USERS_FILE=./data/users.json
CULTURA_TEAMS_FILE=./data/teams.json
CULTURA_COMPETITIONS_FILE=./data/competitions.json
CULTURA_SCHEDULE_ENTRIES_FILE=./data/schedule_entries.json
CULTURA_POSTERS_FILE=./data/posters.json
CULTURA_NOTIFICATIONS_FILE=./data/notifications.json

# ---------------------------------------------------------------------------
# Registration rate limiting
# ---------------------------------------------------------------------------
CULTURA_RATE_LIMIT_MAX=10
CULTURA_RATE_LIMIT_WINDOW=600